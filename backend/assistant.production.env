# WhatsApp assistant settings for the live server. Loaded only when NODE_ENV=production.
# Anything already set in the server's own .env takes priority over this file.
# Never put secrets here: this file is in git. The AI key goes in the server's .env:
#   ASSISTANT_AI_API_KEY=<your OpenAI key>

ASSISTANT_ENABLED=true
ASSISTANT_AI_PROVIDER=openai
ASSISTANT_OPENAI_MODEL=gpt-5.4-nano
ASSISTANT_TIMEZONE=Asia/Kolkata
ASSISTANT_EXECUTION_ENABLED=false

ASSISTANT_WHATSAPP_ENABLED=true
# Kept in the server user's home folder, outside the deploy folder, so redeploys keep the pairing
ASSISTANT_WHATSAPP_SESSION_DIR=~/loop-whatsapp-session

# The Loop Testing group
WHATSAPP_NOTIFICATION_GROUP_JID=120363412745413406@g.us
